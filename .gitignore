claude.md
# Build output ---------------------------------------------------------------
# `build/` is this project's binaryDir and `install/` its CMAKE_INSTALL_PREFIX,
# both set in CMakePresets.json. Everything generated lands in one of the two.
#
# The glob matters: `/build/` alone leaves a second tree such as build-fresh/ or
# build-debug/ untracked-but-not-ignored, which is how one shows up in
# `git status` and, worse, in a careless `git add -A`.
/build*/
/install*/
/out/

# Note: no bare `cmake/` rule. That directory holds superbuild-redirects/, which
# is source and must be committed. Only ignore IDE-generated cmake build dirs.
cmake-build-*/

# Qt ---------------------------------------------------------------------------
# README and CMakeLists both tell you to install Qt into ./qt, and CMakeLists
# auto-detects it there. That is 3.3 GB, so without this rule following the
# project's own instructions leaves `git status` full of it -- and puts it one
# careless `git add -A` away from being committed.
/qt/
# The staging directory the auto-install downloads into before it is renamed to
# qt/. It should never survive a configure, but it exists while one is running.
/qt.tmp/

# CMake ------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
compile_commands.json
# Per-developer preset overrides. CMakePresets.json is committed; this is not.
CMakeUserPresets.json

# vcpkg --------------------------------------------------------------------------
# Manifest mode installs dependencies into the build tree; never commit them.
vcpkg_installed/
.vcpkg-root
# The `files` binary-cache provider's directory. CI points VCPKG_BINARY_SOURCES
# here and actions/cache carries it between runs; locally it is whatever you
# point that variable at.
/vcpkg-cache/

# Visual Studio ------------------------------------------------------------------
# `.vs/*` and not `.vs/`: git cannot re-include a file whose parent directory is
# excluded, so the wholesale rule would make the negation below a no-op.
.vs/*
!.vs/launch.vs.json
*.sln.docstates
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb

# Rider / JetBrains ---------------------------------------------------------------
.idea/
*.iml

# C# / .NET -----------------------------------------------------------------------
# installer_omod carries a C# stub and NuGet references.
[Bb]in/
[Oo]bj/
packages/
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json

# Compiler / linker artefacts ------------------------------------------------------
*.obj
*.o
*.lib
*.a
*.dll
*.so
*.dylib
*.exe
*.pdb
*.ilk
*.exp
*.idb
*.tlog
*.lastbuildstate
*.log

# OS ------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
